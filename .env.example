# MBF Risk Monitor - Mẫu cấu hình môi trường (.env.example)
# Sao chép file này sang .env và điền mật khẩu phù hợp trước khi chạy

# 1. Cơ sở dữ liệu
# Lưu ý khi chạy qua Docker Compose: host là 'db' thay vì '127.0.0.1' (ví dụ: postgres://hsrr_app:change-me-app@db:5432/hsrr)
# Khi chạy trực tiếp tại máy phát triển không qua docker mạng: host là '127.0.0.1'
DATABASE_URL=postgres://hsrr_app:change-me-app@db:5432/hsrr
DATABASE_MIGRATE_URL=postgres://hsrr_owner:change-me-owner@db:5432/hsrr

# Cơ sở dữ liệu kiểm thử tự động vitest (chỉ dùng cho môi trường phát triển trên máy dev)
DATABASE_TEST_URL=postgres://hsrr_app:change-me-app@127.0.0.1:5432/hsrr_test
DATABASE_TEST_MIGRATE_URL=postgres://hsrr_owner:change-me-owner@127.0.0.1:5432/hsrr_test

# Mật khẩu khởi tạo container PostgreSQL
POSTGRES_PASSWORD=change-me-postgres
HSRR_OWNER_PASSWORD=change-me-owner
HSRR_APP_PASSWORD=change-me-app

# 2. Bảo mật và phiên
# SESSION_SECRET: Khóa ký HMAC cho token phiên (bắt buộc >= 32 ký tự ngẫu nhiên).
# Cách sinh khóa ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-chars-minimum-secret-key-mbf-risk-2026

# 3. Cổng và địa chỉ ứng dụng
# Cổng publish ra host cho ứng dụng web (mặc định 127.0.0.1:3000)
WEB_PORT=127.0.0.1:3000

# Địa chỉ nội bộ của api trong mạng docker để web chuyển tiếp /api/*
API_BASE_URL=http://api:3001
API_PORT=3001

# Địa chỉ gốc công khai của website (dùng kiểm tra Origin, HTTPS ở reverse proxy)
APP_ORIGIN=http://localhost:3000

# Địa chỉ IP của reverse proxy được tin cậy nhận tiêu đề X-Forwarded-*
TRUSTED_PROXY_IPS=127.0.0.1

# Múi giờ và mức log
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=info
